#!/usr/bin/env bash
#
# android-16kb-check — verify an Android APK or AAB satisfies Google Play's
# 16 KB memory-page requirement.
#
# Google Play requires apps that target API 35+ to support 16 KB pages on
# 64-bit devices; from 2027-02-01 an update that does not cannot be released.
# https://developer.android.com/guide/practices/page-sizes#google-play-compatibility-requirement
# Two independent things have to hold.
#
#   1. Archive alignment. Native libraries must be stored uncompressed and
#      16 KB-aligned inside the zip. AGP >= 8.5.1 does this; it shows up as
#      PAGE_ALIGNMENT_16K in an AAB's bundle config, or as a clean
#      `zipalign -c -P 16 4` on an APK.
#
#   2. ELF alignment. Every LOAD segment of every 64-bit .so must be aligned
#      to at least 2**14. NDK r28+ links this way by default, but the .so
#      files inside a dependency's AAR were built with whatever NDK its author
#      used, so your own NDK version says nothing about them. This is the half
#      that actually has to be measured on the artifact.
#
# 32-bit armeabi-v7a is exempt (16 KB pages are a 64-bit feature) and is
# reported as SKIP rather than passed over silently.
#
# Exit codes — see --help. 2 means "could not verify" and is NOT a pass.

set -euo pipefail

PROGRAM="android-16kb-check"
VERSION="1.2.0"

# The three-way exit contract. 2 exists so a machine without the toolchain
# reports "unproven" instead of "fine", which is the failure mode that lets an
# unaligned library reach Play.
readonly EXIT_ALIGNED=0
readonly EXIT_UNALIGNED=1
readonly EXIT_CANNOT_VERIFY=2

usage() {
  cat <<EOF
${PROGRAM} ${VERSION}

Verify that an Android APK or AAB meets Google Play's 16 KB page-size
requirement, before you upload it.

USAGE
  ${PROGRAM} [options] <path-to.apk|path-to.aab>

OPTIONS
  --ndk <dir>          Android NDK to take llvm-objdump from. Overrides all
                       auto-detection; if this directory has no llvm-objdump
                       the run fails rather than falling back.
  --bundletool <cmd>   bundletool executable, or a path ending in .jar which
                       is then run as 'java -jar <path>'. AAB only.
  --format <fmt>       text (the default) or json. json writes exactly one
                       JSON object to stdout and moves the text report to
                       stderr; the exit codes do not change. The shape is
                       described in the README under "Machine-readable
                       output". Every result comes as JSON, option errors
                       included, with two exceptions that stay text: a
                       missing or unknown --format value, and --help and
                       --version, which print text and exit 0.
  -h, --help           Show this help and exit 0.
  -V, --version        Print the version and exit 0.

ENVIRONMENT
  ANDROID_NDK_HOME     Same meaning as --ndk (ANDROID_NDK_ROOT also read).
  ANDROID_HOME         SDK root; the highest \$ANDROID_HOME/ndk/<version> is
                       used when no NDK is named explicitly.
                       ANDROID_SDK_ROOT also read.
  BUNDLETOOL           Same meaning as --bundletool.

EXIT CODES
  0  Aligned. Archive alignment is correct and every 64-bit library has all
     LOAD segments at 2**14 or better.
  1  Not aligned. From 1 February 2027 Google Play will not release an
     update like this for an app that targets API 35 or higher.
  2  Could not verify — a required tool or the artifact is missing, or the
     artifact has nothing to check. THIS IS NOT A PASS. Treat it as an
     unproven gate, never as a green light.

PREREQUISITES
  llvm-objdump   from an Android NDK (sdkmanager 'ndk;28.2.13676358').
                 GNU objdump on PATH also works; it prints the same
                 'align 2**N' form.
  bundletool     for AAB input: brew install bundletool
  zipalign       for APK input: ships in \$ANDROID_HOME/build-tools/<version>/
  unzip          to read the libraries out of the archive.
EOF
}

# Every "cannot verify" path funnels through here so the distinction between
# "unaligned" and "unproven" can never be blurred by a stray exit 1.
#
# $1 is a stable id for the cause, used only by --format json (see "Finding
# ids" in the README); $2 is the reason and the rest are explanation lines.
# With --format json it also emits the JSON result, verdict "unverified".
cannot_verify() {
  local id="$1" line
  shift
  printf '%s: CANNOT VERIFY — %s\n' "${PROGRAM}" "$1" >&2
  for line in "${@:2}"; do
    printf '  %s\n' "${line}" >&2
  done
  printf '  Exit code 2 means unproven, not passed.\n' >&2
  add_finding "${id}" error "$1"
  finish unverified "${EXIT_CANNOT_VERIFY}" "$@"
}

# --------------------------------------------------------------- JSON output --
# --format json is built from what the run recorded on the way, without
# changing a byte of the text report. Plain bash 3.2, no jq or python: the
# script has to run on the /bin/bash macOS ships.
#
# The object opens with the envelope shared by the tools in this family
# (schemaVersion, tool, exitCode, summary, findings), and the fields that are
# specific to this check follow it. Keys are camelCase.
#
# With json, file descriptor 3 is the real stdout and carries only the JSON
# object; fd 1 is pointed at stderr once the options are parsed, so nothing
# the text report prints can end up in front of or behind the object.

OUTPUT_FORMAT="text"
JSON_SCHEMA_VERSION=1
JSON_TOOL_NAME="alignmint"
KIND=""
OBJDUMP=""
ARCHIVE_CMD=""      # the archive tool as the header names it
ARCHIVE_JSON="null" # the archive check's result, once it has one
LIB_JSON=""         # the library records, comma-separated
FINDINGS_JSON=""    # the findings, comma-separated
COUNT_ERROR=0
COUNT_WARNING=0
COUNT_INFO=0

# JSON string literal for $1 into the variable named $2. The locals carry a
# prefix so that the caller's variable name cannot be one of them.
json_quote() {
  local _jq_s="$1" _jq_out="" _jq_c _jq_code _jq_i
  _jq_s=${_jq_s//\\/\\\\}
  _jq_s=${_jq_s//\"/\\\"}
  # Control characters are rare (an artifact path can hold a tab or a
  # newline), so the character loop only runs when there is one.
  if [[ "${_jq_s}" == *[[:cntrl:]]* ]]; then
    for (( _jq_i = 0; _jq_i < ${#_jq_s}; _jq_i++ )); do
      _jq_c="${_jq_s:_jq_i:1}"
      case "${_jq_c}" in
        [[:cntrl:]])
          printf -v _jq_code '%d' "'${_jq_c}"
          printf -v _jq_c '\\u%04x' "${_jq_code}"
          ;;
      esac
      _jq_out+="${_jq_c}"
    done
    _jq_s="${_jq_out}"
  fi
  printf -v "$2" '"%s"' "${_jq_s}"
}

# As json_quote, but an empty $1 becomes null.
json_or_null() {
  if [[ -z "$1" ]]; then
    printf -v "$2" 'null'
  else
    json_quote "$1" "$2"
  fi
}

# One finding: $1 stable id, $2 severity (error, warning or info), $3 message.
# Its path is the artifact, once one has been named.
add_finding() {
  [[ "${OUTPUT_FORMAT}" == "json" ]] || return 0
  local msg path rec
  json_quote "$3" msg
  rec="{\"id\":\"$1\",\"severity\":\"$2\",\"message\":${msg}"
  if [[ -n "${ARTIFACT:-}" ]]; then
    json_quote "${ARTIFACT}" path
    rec+=",\"path\":${path}"
  fi
  FINDINGS_JSON+="${FINDINGS_JSON:+,}${rec}}"
  case "$2" in
    error) COUNT_ERROR=$(( COUNT_ERROR + 1 )) ;;
    warning) COUNT_WARNING=$(( COUNT_WARNING + 1 )) ;;
    *) COUNT_INFO=$(( COUNT_INFO + 1 )) ;;
  esac
}

# One record per 64-bit library: $1 module ("" for an APK), $2 abi,
# $3 library name, $4 path in the archive, $5 status (ok or fail), $6 lowest
# LOAD alignment exponent ("" if none was read), $7 reason ("" for ok).
# RELRO is not checked by this script yet, so every library says notChecked.
add_lib() {
  [[ "${OUTPUT_FORMAT}" == "json" ]] || return 0
  local m a n p r rec
  json_or_null "$1" m
  json_quote "$2" a
  json_quote "$3" n
  json_quote "$4" p
  rec="{\"module\":${m},\"abi\":${a},\"name\":${n},\"path\":${p},\"status\":\"$5\""
  rec+=",\"minAlignLog2\":${6:-null}"
  if [[ -n "$7" ]]; then
    json_quote "$7" r
    rec+=",\"reason\":${r}"
  fi
  LIB_JSON+="${LIB_JSON:+,}${rec},\"relro\":{\"status\":\"notChecked\"}}"
}

# One record for an ABI directory as a whole: $1 module, $2 abi, $3 path in
# the archive, $4 status (skip or none), $5 reason, $6 number of .so files.
add_abi_dir() {
  [[ "${OUTPUT_FORMAT}" == "json" ]] || return 0
  local m a p r
  json_or_null "$1" m
  json_quote "$2" a
  json_quote "$3" p
  json_quote "$5" r
  LIB_JSON+="${LIB_JSON:+,}{\"module\":${m},\"abi\":${a},\"path\":${p},\"status\":\"$4\",\"reason\":${r},\"libraryCount\":$6}"
}

# $1 check (bundleConfig or zipalign), $2 status (ok or fail), $3 detail.
set_archive() {
  [[ "${OUTPUT_FORMAT}" == "json" ]] || return 0
  local d
  json_quote "$3" d
  ARCHIVE_JSON="{\"check\":\"$1\",\"status\":\"$2\",\"detail\":${d}}"
}

# $1 verdict, $2 exit code, $3 reason ("" for none), $4... hints.
#
# The hints are the lines the text report prints under the reason, and those
# are wrapped to fit a terminal. In JSON each hint is one whole sentence or
# paragraph, so the wrapping is undone here: a line that does not start with
# an upper-case letter continues the one before it (a lower-case word, an
# indented command, "-P flag: ..."), and is joined to it with one space.
# Write new cannot_verify lines to that rule.
emit_json() {
  local verdict="$1" code="$2" reason tool_version artifact kind objdump archive line
  local hint="" quoted hints=""
  json_or_null "$3" reason
  json_quote "${VERSION}" tool_version
  json_or_null "${ARTIFACT:-}" artifact
  json_or_null "${KIND}" kind
  json_or_null "${OBJDUMP}" objdump
  json_or_null "${ARCHIVE_CMD}" archive
  shift 3
  for line in "$@"; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -n "${line}" ]] || continue
    if [[ -n "${hint}" && "${line}" != [[:upper:]]* ]]; then
      hint+=" ${line}"
      continue
    fi
    if [[ -n "${hint}" ]]; then
      json_quote "${hint}" quoted
      hints+="${hints:+,}${quoted}"
    fi
    hint="${line}"
  done
  if [[ -n "${hint}" ]]; then
    json_quote "${hint}" quoted
    hints+="${hints:+,}${quoted}"
  fi
  {
    printf '{"schemaVersion":%s,"tool":{"name":"%s","version":%s},"exitCode":%s' \
      "${JSON_SCHEMA_VERSION}" "${JSON_TOOL_NAME}" "${tool_version}" "${code}"
    printf ',"summary":{"error":%s,"warning":%s,"info":%s},"findings":[%s]' \
      "${COUNT_ERROR}" "${COUNT_WARNING}" "${COUNT_INFO}" "${FINDINGS_JSON}"
    printf ',"verdict":"%s","reason":%s,"artifact":%s,"kind":%s' \
      "${verdict}" "${reason}" "${artifact}" "${kind}"
    printf ',"tools":{"objdump":%s,"archive":%s},"archive":%s,"libraries":[%s],"hints":[%s]}\n' \
      "${objdump}" "${archive}" "${ARCHIVE_JSON}" "${LIB_JSON}" "${hints}"
  } >&3
}

# Every exit with a verdict goes through here: $1 verdict, $2 exit code,
# $3 reason, $4... hints. The text report has already been printed.
finish() {
  if [[ "${OUTPUT_FORMAT}" == "json" ]]; then
    emit_json "$@"
  fi
  exit "$2"
}

# ------------------------------------------------------------------ options --

ARTIFACT=""
NDK_DIR=""
NDK_SOURCE=""
BUNDLETOOL_SPEC="${BUNDLETOOL:-}"
positional=()
end_of_options=0

if [[ -n "${ANDROID_NDK_HOME:-}" ]]; then
  NDK_DIR="${ANDROID_NDK_HOME}"
  NDK_SOURCE="ANDROID_NDK_HOME"
elif [[ -n "${ANDROID_NDK_ROOT:-}" ]]; then
  NDK_DIR="${ANDROID_NDK_ROOT}"
  NDK_SOURCE="ANDROID_NDK_ROOT"
fi

need_value() {
  # $1 = flag name, $2 = number of args remaining after the flag, $3 = the
  # value itself. An EMPTY value is rejected as hard as an absent one: an
  # unset variable in a caller's script (--ndk "$NDK_HOME") would otherwise
  # look like "no --ndk at all", and the run would quietly fall back to
  # auto-detection after being told which toolchain to use. That is the
  # silent-fallback failure this tool exists to refuse.
  if (( $2 == 0 )) || [[ -z "${3:-}" ]]; then
    cannot_verify option-invalid "$1 requires a value." "Run ${PROGRAM} --help for usage."
  fi
}

# --format is found before the options are parsed for real, so that an error
# in any other option is already reported in the format asked for. This pass
# only looks: it skips the values of --ndk and --bundletool the way the real
# parse does, and it falls back to text if any --format value is missing or
# unknown, since the real parse below will then stop on that value and there
# is no agreed format to report it in.
scan_format() {
  local fmt="" bad=0
  while (( $# )); do
    case "$1" in
      --) break ;;
      --ndk|--bundletool) if (( $# > 1 )); then shift; fi ;;
      --format|--format=*)
        if [[ "$1" == "--format" ]]; then
          fmt="${2:-}"
          if (( $# > 1 )); then shift; fi
        else
          fmt="${1#--format=}"
        fi
        case "${fmt}" in
          text|json) ;;
          *) bad=1 ;;
        esac
        ;;
    esac
    shift
  done
  if (( bad == 0 )) && [[ "${fmt}" == "json" ]]; then
    OUTPUT_FORMAT="json"
  fi
}
scan_format "$@"
if [[ "${OUTPUT_FORMAT}" == "json" ]]; then
  exec 3>&1
fi

check_format() {
  case "$1" in
    text|json) ;;
    "") cannot_verify option-invalid "--format requires a value." "Run ${PROGRAM} --help for usage." ;;
    *) cannot_verify option-invalid "unknown --format value: $1" "Expected text or json." ;;
  esac
}

while (( $# )); do
  if (( end_of_options )); then
    positional+=("$1")
    shift
    continue
  fi
  case "$1" in
    --) end_of_options=1 ;;
    -h|--help) usage; exit "${EXIT_ALIGNED}" ;;
    -V|--version) printf '%s %s\n' "${PROGRAM}" "${VERSION}"; exit "${EXIT_ALIGNED}" ;;
    --ndk) need_value --ndk $(( $# - 1 )) "${2:-}"; NDK_DIR="$2"; NDK_SOURCE="--ndk"; shift ;;
    --ndk=*) NDK_DIR="${1#--ndk=}"; NDK_SOURCE="--ndk"
             [[ -n "${NDK_DIR}" ]] || cannot_verify option-invalid "--ndk requires a value." ;;
    --bundletool) need_value --bundletool $(( $# - 1 )) "${2:-}"; BUNDLETOOL_SPEC="$2"; shift ;;
    --bundletool=*) BUNDLETOOL_SPEC="${1#--bundletool=}"
                    [[ -n "${BUNDLETOOL_SPEC}" ]] || cannot_verify option-invalid "--bundletool requires a value." ;;
    --format) need_value --format $(( $# - 1 )) "${2:-}"; check_format "$2"; shift ;;
    --format=*) check_format "${1#--format=}" ;;
    -*) cannot_verify option-invalid "unknown option: $1" "Run ${PROGRAM} --help for usage." ;;
    *) positional+=("$1") ;;
  esac
  shift
done

# From here on the text report goes to stderr in json mode; fd 3 keeps stdout.
if [[ "${OUTPUT_FORMAT}" == "json" ]]; then
  exec 1>&2
fi

if (( ${#positional[@]} == 0 )); then
  cannot_verify artifact-missing "no artifact given." \
    "Usage: ${PROGRAM} [options] <path-to.apk|path-to.aab>" \
    "Run ${PROGRAM} --help for the full option list."
fi
if (( ${#positional[@]} > 1 )); then
  cannot_verify option-invalid "expected exactly one artifact, got ${#positional[@]}." \
    "Extra arguments: ${positional[*]:1}"
fi
ARTIFACT="${positional[0]}"

if [[ ! -e "${ARTIFACT}" ]]; then
  cannot_verify artifact-missing "artifact not found: ${ARTIFACT}" \
    "Build one first, then point this tool at the .aab or .apk it produced."
fi
if [[ ! -f "${ARTIFACT}" ]]; then
  cannot_verify artifact-invalid "not a regular file: ${ARTIFACT}"
fi

case "${ARTIFACT}" in
  *.aab) KIND=aab ;;
  *.apk) KIND=apk ;;
  *) cannot_verify artifact-invalid "expected a .aab or .apk, got: ${ARTIFACT}" \
       "The check reads the archive layout, which differs between the two." ;;
esac

# ----------------------------------------------------------------- toolchain --
# Everything is resolved up front. Failing after half the work is done invites
# reading a partial report as a result.

command -v unzip >/dev/null 2>&1 || cannot_verify tool-missing "unzip not found on PATH." \
  "It is needed to read the native libraries out of the archive." \
  "Debian/Ubuntu: apt-get install unzip    macOS: preinstalled"

SDK_ROOT="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}"
if [[ -z "${SDK_ROOT}" ]]; then
  for candidate in "${HOME}/Library/Android/sdk" "${HOME}/Android/Sdk"; do
    if [[ -d "${candidate}" ]]; then
      SDK_ROOT="${candidate}"
      break
    fi
  done
fi

# llvm-objdump inside an NDK lives under a host-triple directory whose name is
# not knowable up front (darwin-x86_64, linux-x86_64, ...), hence the glob.
objdump_in_ndk() {
  local ndk="$1" cand
  for cand in "${ndk}"/toolchains/llvm/prebuilt/*/bin/llvm-objdump; do
    if [[ -x "${cand}" ]]; then
      printf '%s\n' "${cand}"
      return 0
    fi
  done
  return 1
}

# Is dotted version $1 strictly greater than dotted version $2?
#
# Done in bash rather than with `sort`, because every portable spelling of this
# has a trap in it. `sort -V` is a GNU extension. `sort -t. -k1,1n` looks right
# but only works on bare versions: fed whole PATHS it puts the directory prefix
# in field 1, where a numeric compare reads it as 0 on both BSD and GNU, so the
# major version is never compared at all and 26.3.x beats 28.2.x.
version_gt() {
  local -a a b
  IFS=. read -r -a a <<<"$1"
  IFS=. read -r -a b <<<"$2"
  local i x y n=$(( ${#a[@]} > ${#b[@]} ? ${#a[@]} : ${#b[@]} ))
  for (( i = 0; i < n; i++ )); do
    x="${a[i]:-0}"
    y="${b[i]:-0}"
    [[ "${x}" =~ ^[0-9]+$ ]] || x=0
    [[ "${y}" =~ ^[0-9]+$ ]] || y=0
    # 10# so a zero-padded field is not read as octal.
    if (( 10#${x} > 10#${y} )); then return 0; fi
    if (( 10#${x} < 10#${y} )); then return 1; fi
  done
  return 1
}

# Highest installed NDK, compared by numeric version fields rather than string
# order, so 28.2.x wins over 9.x and over 26.3.x.
# Prints nothing when the SDK has no ndk directory.
highest_ndk() {
  local root="$1" dir name best="" best_name=""
  for dir in "${root}"/ndk/*/; do
    [[ -d "${dir}" ]] || continue
    dir="${dir%/}"
    name="${dir##*/}"
    if [[ -z "${best}" ]] || version_gt "${name}" "${best_name}"; then
      best="${dir}"
      best_name="${name}"
    fi
  done
  if [[ -n "${best}" ]]; then
    printf '%s\n' "${best}"
  fi
  return 0
}

if [[ -n "${NDK_DIR}" ]]; then
  # An explicitly named NDK is authoritative. Silently falling back to some
  # other objdump would report on a toolchain nobody asked for.
  if ! OBJDUMP="$(objdump_in_ndk "${NDK_DIR}")"; then
    cannot_verify tool-missing "no llvm-objdump under the NDK named by ${NDK_SOURCE}: ${NDK_DIR}" \
      "Expected ${NDK_DIR}/toolchains/llvm/prebuilt/<host>/bin/llvm-objdump" \
      "Install it with: sdkmanager 'ndk;28.2.13676358'" \
      "$(if [[ "${NDK_SOURCE}" == "--ndk" ]]; then
           echo "Or drop --ndk to fall back to auto-detection."
         else
           echo "Or unset ${NDK_SOURCE} to fall back to auto-detection."
         fi)"
  fi
elif [[ -n "${SDK_ROOT}" && -d "${SDK_ROOT}/ndk" ]]; then
  ndk_candidate="$(highest_ndk "${SDK_ROOT}")"
  if [[ -n "${ndk_candidate}" ]]; then
    OBJDUMP="$(objdump_in_ndk "${ndk_candidate}" || true)"
  fi
fi

if [[ -z "${OBJDUMP}" ]]; then
  OBJDUMP="$(command -v llvm-objdump 2>/dev/null || command -v objdump 2>/dev/null || true)"
fi

if [[ -z "${OBJDUMP}" ]]; then
  cannot_verify tool-missing "no llvm-objdump found." \
    "It ships with the Android NDK. Install one:" \
    "    sdkmanager 'ndk;28.2.13676358'" \
    "Then set ANDROID_HOME (or pass --ndk /path/to/ndk/28.2.13676358)." \
    "GNU objdump on PATH also works if you have binutils."
fi

# bundletool for AAB, zipalign for APK. Resolved here, used further down.
BUNDLETOOL_CMD=()
ZIPALIGN=""
if [[ "${KIND}" == "aab" ]]; then
  if [[ -n "${BUNDLETOOL_SPEC}" ]]; then
    case "${BUNDLETOOL_SPEC}" in
      *.jar)
        command -v java >/dev/null 2>&1 || cannot_verify tool-missing \
          "bundletool was given as a .jar but java is not on PATH." \
          "Install a JDK, or point --bundletool at a launcher script instead."
        [[ -f "${BUNDLETOOL_SPEC}" ]] || cannot_verify tool-missing \
          "bundletool jar not found: ${BUNDLETOOL_SPEC}"
        BUNDLETOOL_CMD=(java -jar "${BUNDLETOOL_SPEC}")
        ;;
      *)
        if [[ -x "${BUNDLETOOL_SPEC}" ]]; then
          BUNDLETOOL_CMD=("${BUNDLETOOL_SPEC}")
        elif command -v "${BUNDLETOOL_SPEC}" >/dev/null 2>&1; then
          BUNDLETOOL_CMD=("${BUNDLETOOL_SPEC}")
        else
          cannot_verify tool-missing "bundletool not executable: ${BUNDLETOOL_SPEC}"
        fi
        ;;
    esac
  elif command -v bundletool >/dev/null 2>&1; then
    BUNDLETOOL_CMD=(bundletool)
  else
    cannot_verify tool-missing "bundletool not found on PATH." \
      "It reads the bundle config, which is where an AAB records its" \
      "archive alignment. Install it:" \
      "    brew install bundletool" \
      "Or download bundletool-all.jar from" \
      "    https://github.com/google/bundletool/releases" \
      "and pass --bundletool /path/to/bundletool-all.jar" \
      "An APK needs zipalign instead of bundletool."
  fi
else
  for cand in "${SDK_ROOT:-/nonexistent}"/build-tools/*/zipalign; do
    # Later build-tools versions sort last; the newest is the one we want.
    [[ -x "${cand}" ]] && ZIPALIGN="${cand}"
  done
  if [[ -z "${ZIPALIGN}" ]]; then
    ZIPALIGN="$(command -v zipalign 2>/dev/null || true)"
  fi
  if [[ -z "${ZIPALIGN}" ]]; then
    cannot_verify tool-missing "zipalign not found." \
      "It ships in the Android SDK build-tools and is what proves an APK's" \
      "native libraries are stored 16 KB-aligned inside the zip." \
      "    sdkmanager 'build-tools;35.0.0'" \
      "Then set ANDROID_HOME to your SDK root." \
      "Looked under: ${SDK_ROOT:-<no SDK root known>}/build-tools/*/zipalign"
  fi
fi

if [[ "${KIND}" == "aab" ]]; then
  ARCHIVE_CMD="${BUNDLETOOL_CMD[*]}"
else
  ARCHIVE_CMD="${ZIPALIGN}"
fi

# -------------------------------------------------------------------- report --

printf '==> artifact : %s\n' "${ARTIFACT}"
printf '==> objdump  : %s\n' "${OBJDUMP}"
if [[ "${KIND}" == "aab" ]]; then
  printf '==> archive  : %s (bundletool)\n' "${BUNDLETOOL_CMD[*]}"
else
  printf '==> archive  : %s (zipalign)\n' "${ZIPALIGN}"
fi
printf '\n'

# ------------------------------------------------------------------- archive --
# Zip-level alignment, independent of the ELF check below: a correctly-linked
# .so stored compressed still fails on device, and a badly-linked .so stored
# with perfect zip alignment fails too. Both have to hold.

printf '==> Archive alignment\n'
if [[ "${KIND}" == "aab" ]]; then
  # stderr is dropped on purpose: recent JDKs print a sun.misc.Unsafe
  # deprecation warning from bundletool's bundled protobuf on every call.
  if ! config="$("${BUNDLETOOL_CMD[@]}" dump config --bundle="${ARTIFACT}" 2>/dev/null)"; then
    cannot_verify archive-unreadable "bundletool could not read ${ARTIFACT}." \
      "Is it really an app bundle? bundletool dump config failed."
  fi
  if printf '%s\n' "${config}" | grep -q 'PAGE_ALIGNMENT_16K'; then
    printf '    [ok]   bundle config declares PAGE_ALIGNMENT_16K\n'
    set_archive bundleConfig ok "bundle config declares PAGE_ALIGNMENT_16K"
  else
    printf '    [FAIL] bundle config does NOT declare PAGE_ALIGNMENT_16K\n' >&2
    printf '           uncompressNativeLibraries block was:\n' >&2
    printf '%s\n' "${config}" | grep -A3 'uncompressNativeLibraries' >&2 || \
      printf '           (not present at all)\n' >&2
    printf '\n' >&2
    printf 'FAIL — the bundle is not storing native libraries 16 KB-aligned.\n' >&2
    printf '  This comes from the Android Gradle Plugin. Upgrade to AGP 8.5.1 or newer.\n' >&2
    set_archive bundleConfig fail "bundle config does NOT declare PAGE_ALIGNMENT_16K"
    add_finding archive-unaligned error \
      "the bundle config does not declare PAGE_ALIGNMENT_16K, so native libraries are not stored 16 KB-aligned."
    finish unaligned "${EXIT_UNALIGNED}" \
      "the bundle is not storing native libraries 16 KB-aligned." \
      "This comes from the Android Gradle Plugin. Upgrade to AGP 8.5.1 or newer."
  fi
else
  # zipalign's status is read on its own, for the same reason objdump's is
  # below: 1 means it checked the archive and found it misaligned, and
  # anything above that means it never got as far as checking. The case that
  # actually happens is build-tools older than 35, whose zipalign has no -P
  # flag at all and exits 2 on the usage error — reading that as "not
  # aligned" announces a failure about an archive nobody measured.
  zipalign_status=0
  "${ZIPALIGN}" -c -P 16 4 "${ARTIFACT}" >/dev/null 2>&1 || zipalign_status=$?
  if (( zipalign_status == 0 )); then
    printf '    [ok]   zipalign -c -P 16 4: verification successful\n'
    set_archive zipalign ok "zipalign -c -P 16 4: verification successful"
  elif (( zipalign_status == 1 )); then
    printf '    [FAIL] zipalign reports the APK is not 16 KB aligned\n' >&2
    "${ZIPALIGN}" -v -c -P 16 4 "${ARTIFACT}" 2>&1 | grep -i 'bad\|fail' >&2 || true
    printf '\n' >&2
    printf 'FAIL — native libraries are not stored 16 KB-aligned in the zip.\n' >&2
    printf '  This comes from the Android Gradle Plugin. Upgrade to AGP 8.5.1 or newer.\n' >&2
    set_archive zipalign fail "zipalign reports the APK is not 16 KB aligned"
    add_finding archive-unaligned error \
      "zipalign -c -P 16 4 reports that native libraries are not stored 16 KB-aligned in the zip."
    finish unaligned "${EXIT_UNALIGNED}" \
      "native libraries are not stored 16 KB-aligned in the zip." \
      "This comes from the Android Gradle Plugin. Upgrade to AGP 8.5.1 or newer."
  else
    cannot_verify tool-failed "zipalign could not perform the check (exit ${zipalign_status})." \
      "It returns 1 when it has read the archive and found it misaligned;" \
      "any other status means it never got that far, so nothing was measured." \
      "The usual cause is build-tools older than 35, whose zipalign has no" \
      "-P flag: ${ZIPALIGN}" \
      "Install a newer one with: sdkmanager 'build-tools;35.0.0'"
  fi
fi
printf '\n'

# ----------------------------------------------------------------------- ELF --

WORK="$(mktemp -d)"
trap 'rm -rf "${WORK}"' EXIT

# Where the libraries live. An APK puts them at lib/<abi>/. An AAB keeps them
# per module, at <module>/lib/<abi>/ — base/, plus one directory for every
# dynamic feature or other module. The Play requirement covers every .so in
# the bundle, and a feature module is a common home for exactly the kind of
# prebuilt library this check exists to catch, so every module is read, not
# only base.
#
# Three parallel arrays, one entry per library root:
#   LIB_PATTERNS  what to ask unzip for
#   LIB_ROOTS     where that lands under ${WORK}
#   LIB_LABELS    what to print in front of an ABI or library name. Empty for
#                 an APK and for an AAB's base module, so the common report
#                 reads as it always has; "<module>/lib/" for any other
#                 module, so a [FAIL] there names the module it is in.
#
# LIB_MODULES holds the module name for an AAB and is empty for an APK; it is
# only used for --format json.
LIB_PATTERNS=()
LIB_ROOTS=()
LIB_LABELS=()
LIB_MODULES=()
if [[ "${KIND}" == "aab" ]]; then
  # The module list comes from the archive's own listing rather than from a
  # '*/lib/*' extraction pattern. unzip's '*' also matches '/', so that
  # pattern would pull in base/assets/lib/... or anything else with a lib/
  # somewhere in its path. BUNDLE-METADATA/ and META-INF/ are not modules.
  if ! listing="$(unzip -Z1 "${ARTIFACT}" 2>/dev/null)"; then
    cannot_verify archive-unreadable "unzip could not list the entries of ${ARTIFACT}." \
      "Without the entry list there is no way to know which modules carry" \
      "native libraries, so none of them were measured." \
      "Usual causes: a truncated or corrupt archive."
  fi
  # base sorts first, the rest alphabetically, so the report always opens
  # with the module most people are looking for.
  modules="$(printf '%s\n' "${listing}" \
    | awk -F/ 'NF >= 4 && $2 == "lib" && $1 != "" &&
               $1 != "BUNDLE-METADATA" && $1 != "META-INF" {
                 print ($1 == "base" ? "0 " : "1 ") $1
               }' \
    | sort -u | sed 's/^[01] //')"
  while IFS= read -r module; do
    [[ -n "${module}" ]] || continue
    LIB_PATTERNS+=("${module}/lib/*")
    LIB_ROOTS+=("${module}/lib")
    LIB_MODULES+=("${module}")
    if [[ "${module}" == "base" ]]; then
      LIB_LABELS+=("")
    else
      LIB_LABELS+=("${module}/lib/")
    fi
  done <<EOF
${modules}
EOF
  NO_LIBS_HINT="Expected <module>/lib/<abi>/*.so in at least one module of ${ARTIFACT}."
else
  LIB_PATTERNS=('lib/*')
  LIB_ROOTS=('lib')
  LIB_LABELS=('')
  LIB_MODULES=('')
  NO_LIBS_HINT="Expected lib/* inside ${ARTIFACT}."
fi

no_native_libraries() {
  cannot_verify no-native-libraries "no native libraries found in the artifact." \
    "${NO_LIBS_HINT}" \
    "Either this is the wrong file, or the build produced no .so at all." \
    "An app with no native code has nothing for this check to measure."
}

# Checked before the arrays are expanded: "${empty[@]}" is an unbound-variable
# error under set -u in the bash 3.2 that macOS ships.
if (( ${#LIB_ROOTS[@]} == 0 )); then
  no_native_libraries
fi

# unzip's status is not discarded. If it refuses even one entry — an
# unsupported compression method, a truncated archive, a full ${TMPDIR} — the
# tree below is a SUBSET of the artifact, and measuring a subset while
# printing PASS is the same green-without-looking answer as measuring
# nothing. 0 is a clean extraction, 1 is "extracted, with warnings", and 11
# is "nothing matched the pattern", which the missing-root check just below
# reports properly.
unzip_status=0
unzip -q "${ARTIFACT}" "${LIB_PATTERNS[@]}" -d "${WORK}" >/dev/null 2>&1 || unzip_status=$?
case "${unzip_status}" in
  0|1|11) ;;
  *) cannot_verify archive-unreadable "unzip could not read every native-library entry out of the artifact (exit ${unzip_status})." \
       "Part of the archive was skipped, so a verdict here would cover some" \
       "of the native libraries rather than all of them." \
       "Usual causes: a compression method this unzip does not support, a" \
       "truncated or corrupt archive, or no space left in \${TMPDIR}." ;;
esac

for root in "${LIB_ROOTS[@]}"; do
  if [[ ! -d "${WORK}/${root}" ]]; then
    if [[ "${KIND}" == "apk" ]]; then
      no_native_libraries
    fi
    # The AAB listing named this module, so its libraries exist; if they did
    # not come out, the rest of the tree is a subset of the bundle.
    cannot_verify archive-unreadable "the archive lists ${root}/ but nothing under it was extracted." \
      "A verdict on the other modules would not cover this one."
  fi
done

fail=0
abis64=0     # 64-bit ABI directories present in the archive, over all modules
measured=0   # 64-bit .so files actually read

# Measure every library under one root. $1 is the extracted root directory,
# $2 the label from LIB_LABELS, $3 the root's path inside the archive (from
# LIB_ROOTS) and $4 the module from LIB_MODULES.
check_lib_root() {
  local root="$1" label="$2" in_archive="$3" module="$4"
  local abi_dir abi n in_this_abi so so_name where raw aligns worst token exponent

  for abi_dir in "${root}"/*; do
    [[ -d "${abi_dir}" ]] || continue
    abi="$(basename "${abi_dir}")"

    # 16 KB pages are a 64-bit feature. Say so out loud — an ABI reported
    # nowhere reads exactly like an ABI that passed.
    if [[ "${abi}" != *64* ]]; then
      n="$(find "${abi_dir}" -name '*.so' | wc -l | tr -d ' ')"
      printf '    %-14s [SKIP] 32-bit, exempt (%s libs)\n' "${label}${abi}" "${n}"
      add_abi_dir "${module}" "${abi}" "${in_archive}/${abi}" skip "32-bit" "${n}"
      continue
    fi
    abis64=$(( abis64 + 1 ))
    in_this_abi=0

    for so in "${abi_dir}"/*.so; do
      [[ -f "${so}" ]] || continue
      so_name="$(basename "${so}")"
      in_this_abi=$(( in_this_abi + 1 ))
      measured=$(( measured + 1 ))

      # Outside an AAB's base module the line names the library by its path
      # in the bundle, in the same width as the two columns it replaces, so
      # the verdicts still line up.
      if [[ -n "${label}" ]]; then
        printf -v where '%-53s' "${label}${abi}/${so_name}"
      else
        printf -v where '%-14s %-38s' "${abi}" "${so_name}"
      fi

      # objdump -p prints one 'align 2**N' per program header. Only LOAD
      # matters; anything below 2**14 breaks on a 16 KB-page device.
      #
      # objdump's exit status is read on its own, before any parsing. The two
      # cases below look identical in the output — both produce no 'align'
      # tokens — but they are opposite answers:
      #
      #   objdump ran and found no readable LOAD segments -> the ARTIFACT is
      #   broken, which is a [FAIL].
      #   objdump could not run at all -> nothing was measured, which is a 2.
      #
      # Collapsing the second into the first reports a FAIL about a library
      # the tool never managed to look at.
      if ! raw="$("${OBJDUMP}" -p "${so}" 2>/dev/null)"; then
        cannot_verify tool-failed "${OBJDUMP##*/} could not read ${label}${abi}/${so_name}." \
          "Command: ${OBJDUMP} -p <${so_name}>" \
          "Nothing was measured for this library, so the artifact is unproven." \
          "Check that the objdump above runs on this machine, and that the" \
          "artifact is not truncated or corrupt."
      fi
      aligns="$(printf '%s\n' "${raw}" \
                  | awk '$1=="LOAD"{for(i=1;i<=NF;i++) if($i=="align") print $(i+1)}')"

      worst=99
      while read -r token; do
        exponent="${token#2\*\*}"
        [[ "${exponent}" =~ ^[0-9]+$ ]] || continue
        if (( exponent < worst )); then
          worst="${exponent}"
        fi
      done <<EOF
${aligns}
EOF

      if (( worst == 99 )); then
        printf '    %s [FAIL] no LOAD segments readable\n' "${where}" >&2
        add_lib "${module}" "${abi}" "${so_name}" "${in_archive}/${abi}/${so_name}" \
          fail "" "no LOAD segments readable"
        add_finding library-no-load error \
          "${in_archive}/${abi}/${so_name}: objdump read the library but found no readable LOAD segments."
        fail=1
      elif (( worst < 14 )); then
        printf '    %s [FAIL] min align 2**%s\n' "${where}" "${worst}" >&2
        add_lib "${module}" "${abi}" "${so_name}" "${in_archive}/${abi}/${so_name}" \
          fail "${worst}" "min align 2**${worst}, below 2**14"
        add_finding library-unaligned error \
          "${in_archive}/${abi}/${so_name}: LOAD segments aligned to 2**${worst}, below the 2**14 that 16 KB pages need."
        fail=1
      else
        printf '    %s [ok]   min align 2**%s\n' "${where}" "${worst}"
        add_lib "${module}" "${abi}" "${so_name}" "${in_archive}/${abi}/${so_name}" \
          ok "${worst}" ""
      fi
    done

    # A 64-bit ABI directory holding no .so is not the same as one that
    # passed, and it must not be reported by saying nothing. lib/<abi>/ can
    # legitimately hold non-library files (wrap.sh, for one), so this shape
    # does occur.
    if (( in_this_abi == 0 )); then
      printf '    %-14s [none] directory present but holds no .so\n' "${label}${abi}" >&2
      add_abi_dir "${module}" "${abi}" "${in_archive}/${abi}" none \
        "directory present but holds no .so" 0
      add_finding abi-without-libraries warning \
        "${in_archive}/${abi}/ is a 64-bit ABI directory that holds no .so, so nothing in it was measured."
    fi
  done
}

printf '==> ELF LOAD segment alignment (must be >= 2**14)\n'
i=0
while (( i < ${#LIB_ROOTS[@]} )); do
  check_lib_root "${WORK}/${LIB_ROOTS[i]}" "${LIB_LABELS[i]}" "${LIB_ROOTS[i]}" "${LIB_MODULES[i]}"
  i=$(( i + 1 ))
done

printf '\n'
if (( abis64 == 0 )); then
  cannot_verify 32-bit-only "the artifact contains no 64-bit ABI, so there is nothing to check." \
    "16 KB pages only apply to arm64-v8a and x86_64." \
    "A 32-bit-only build is not proof of anything about the 64-bit one."
fi
# A 64-bit directory that yielded no library leaves the run with a verdict on
# nothing. Reporting PASS here would be the exact failure this tool exists to
# refuse: a green result from an artifact that was never measured.
if (( measured == 0 )); then
  cannot_verify nothing-measured "no 64-bit library was read, so nothing was measured." \
    "The artifact has a 64-bit ABI directory, but it contains no .so files." \
    "Either this is not the artifact you meant to check, or its 64-bit" \
    "native code is missing. Neither is evidence of alignment."
fi
if (( fail )); then
  printf 'FAIL — at least one 64-bit library is not 16 KB aligned.\n' >&2
  cat >&2 <<'EOF'
  Google Play: from 1 February 2027, updates of apps that target Android 15
  (API 35) or higher cannot be released unless they support 16 KB memory pages.
  https://developer.android.com/guide/practices/page-sizes#google-play-compatibility-requirement
  This check does not read targetSdk. Since 31 August 2026 Play requires phone
  app updates to target API 36, so this applies to almost every update.
  https://developer.android.com/google/play/requirements/target-sdk
  On 16 KB devices an unaligned library may still run in backcompat mode;
  that does not lift the Play requirement.

  Libraries you compile yourself are aligned by NDK r28 or newer.
  A failure here is usually a PREBUILT .so shipped inside a dependency.
  Bumping your own ndkVersion cannot fix that binary — find the dependency
  that owns the .so named above and upgrade it to a release that ships
  16 KB-aligned libraries, or drop it.
EOF
  finish unaligned "${EXIT_UNALIGNED}" \
    "at least one 64-bit library is not 16 KB aligned." \
    "A failure is usually a prebuilt .so shipped inside a dependency, built with an older NDK; upgrade or drop the dependency that owns it."
fi
printf 'PASS — archive alignment and every 64-bit library meet the 16 KB page requirement.\n'
finish aligned "${EXIT_ALIGNED}" ""
